# No invented public domain. Set the owner-approved HTTPS origin when confirmed.
SITE_URL=
# Phase 6: disabled until owner supplies account/inbox and legal arrangements are final.
CONTACT_ENABLED=false
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional, independently approved public email shown as a mailto link.
CONTACT_PUBLIC_EMAIL=
RESEND_API_KEY=
# Generate at least 32 random characters; server-only, used for keyed identifiers.
CONTACT_RATE_LIMIT_SECRET=
# Set to netlify only behind Netlify's trusted client-IP header. Otherwise shared bucket.
CONTACT_TRUSTED_PROXY=

# Optional local-only Work/Insights review. Not authentication; keep false on public hosts.
ENABLE_DESIGN_REVIEW=false
